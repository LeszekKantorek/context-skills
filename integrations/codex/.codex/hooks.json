{
  "description": "Selective project context and deferred session review",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Use context for project memory in .context/INDEX.md: retrieve relevant entries and record durable, evidence-backed learning at meaningful boundaries. Read known entries directly; use context-find-related for broad or ambiguous searches.\"",
            "commandWindows": "echo \"Use context for project memory in .context/INDEX.md: retrieve relevant entries and record durable, evidence-backed learning at meaningful boundaries. Read known entries directly; use context-find-related for broad or ambiguous searches.\"",
            "statusMessage": "Loading project context guidance",
            "additionalContextLimit": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
