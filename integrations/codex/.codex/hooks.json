{
  "description": "Selective project context and deferred session review",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Use context-apply for relevant knowledge in .context; context-gather when sources are missing or unclear; context-consolidate for durable learning. Read only what the task needs. No index or full skill sequence is required. Exclude .context/sessions from knowledge retrieval.\"",
            "commandWindows": "echo \"Use context-apply for relevant knowledge in .context; context-gather when sources are missing or unclear; context-consolidate for durable learning. Read only what the task needs. No index or full skill sequence is required. Exclude .context/sessions from knowledge retrieval.\"",
            "statusMessage": "Loading project context guidance",
            "additionalContextLimit": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/context_queue_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& python ((git rev-parse --show-toplevel) + '/.codex/hooks/context_queue_session.py')\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
